{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },

  "ConnectionStrings": {
    //"SqlServer": {
    //  "PIM": "Data Source=xxx,9999;Initial Catalog=regira_pim;User ID=xxx;Password=xxx;TrustServerCertificate=True",
    //  "Accounts": "Data Source=xxx,9999;Initial Catalog=regira_pim_accounts;User ID=xxx;Password=xxx;TrustServerCertificate=True"
    //},
    "Sqlite": {
      "PIM": "Data Source=xxx\\regira-pim.db",
      "Accounts": "Data Source=XXX\\accounts.db"
    }
  },

  // Set to "OpenFoodFacts" (or pass --off) to import the Open Food Facts dump instead of the
  // hand-built recipe catalog. Requires the SqlServer connection string above.
  "DataSource": "Recipes",

  "OpenFoodFacts": {
    // Cache for the downloaded dump — needs ~13 GB free. Defaults to an "off-data" folder
    // next to the executable when left unset.
    "DataDir": "C:\\Data\\Regira-PIM\\OFF-data",
    // Open Food Facts rate-limits per IP and asks clients to identify themselves.
    // Put a real contact address here — anonymous clients get throttled quickly.
    "UserAgent": "Regira-PIM-DataGenerator/1.0 (bram@regira.com)",
    "RequestDelaySeconds": 4,
    "MaxRetries": 6,
    // Set to null to import all ~4.7 million products. Start smaller to validate the pipeline.
    "MaxProducts": 250000,
    "BatchSize": 50000,
    "ImportBrands": true,
    "TaxonomyIngredientsOnly": true,
    "RequireIngredients": false,
    // Keep only products written in this language, e.g. "en". Null imports every language.
    // MaxProducts counts products imported, so the scan reads further into the dump to reach it.
    "Language": "en",
    // Deletes the existing catalog and taxonomy first. Leave off unless the target is a throwaway
    // database: a connection string in user secrets overrides both appsettings and environment
    // variables, so the server written to is not necessarily the one named here.
    "TruncateBeforeImport": false,
    // Shape of the shared ingredient graph.
    "MaxComponentsPerIngredient": 20,
    "MaxIngredientDepth": 9
  }
}
